spring:
  application:
    name: user-management
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: true
    locations: classpath:db/migration/{vendor}
  mail:
    host: @MAIL_HOST@
    port: @MAIL_PORT@
    username: @MAIL_USERNAME@
    password: @MAIL_PASSWORD@
    properties:
      "[mail.smtp.auth]": true
      "[mail.smtp.starttls.enable]": true
      "[mail.smtp.connectiontimeout]": 5000
      "[mail.smtp.timeout]": 3000
      "[mail.smtp.writetimeout]": 5000
  mvc:
    problemdetails:
      enabled: true  # Enable RFC 9457 ProblemDetail error responses

app:
  jwt:
    secret: @JWT_SECRET@
    expiration-ms: @JWT_EXPIRATION_MS@
    remember-me-expiration-ms: @JWT_REMEMBER_ME_EXPIRATION_MS@
  mail:
    from: @MAIL_FROM@
  verification:
    expiration-hours: @VERIFICATION_EXPIRATION_HOURS@
    base-url: @APP_BASE_URL@

springdoc:
  pathsToMatch: /api/v1/**
  swagger-ui:
    path: /swagger-ui.html
    display-request-duration: true
    operationsSorter: method
    tagsSorter: alpha

server:
  port: @APP_PORT@

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: when-authorized
