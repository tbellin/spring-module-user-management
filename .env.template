# ===========================================
# User Management Application - Environment Configuration
# ===========================================
# Copy this file to .env and replace CHANGE_ME values with actual secrets.
# Run: bin/generate-config.sh (or bin/setup.sh for full setup)

# ===========================================
# Database Configuration
# ===========================================
# These credentials are used by the Spring app to connect to PostgreSQL.
# They also define the PostgreSQL superuser created on first launch.
# PgAdmin's pre-configured server connection uses these same credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=userdb
DB_USERNAME=appuser
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ===========================================
# PgAdmin Configuration
# ===========================================
# PgAdmin is a web UI for managing PostgreSQL databases.
#
# How to access PgAdmin:
#   1. Open http://localhost:5050 in your browser
#   2. Log in with PGADMIN_EMAIL and PGADMIN_PASSWORD (below)
#   3. In the left sidebar, expand Servers > "User Management DB"
#   4. Enter DB_PASSWORD (from the Database Configuration section above)
#   5. You now have access to the "userdb" database, its tables, and data
#
# Note: The server connection is auto-configured via docker/pgadmin/servers.json.
#       You only need to provide DB_PASSWORD on first connection.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# ===========================================
# Application Configuration
# ===========================================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# JWT Configuration (used in later phases)
# ===========================================
JWT_SECRET=CHANGE_ME_TO_BASE64_ENCODED_256BIT_SECRET
JWT_EXPIRATION_MS=3600000
JWT_REMEMBER_ME_EXPIRATION_MS=604800000

# ===========================================
# Mail Configuration (Gmail SMTP)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_TO_GMAIL_ADDRESS
MAIL_PASSWORD=CHANGE_ME_TO_APP_PASSWORD
MAIL_FROM=noreply@jbeltsolution.com

# ===========================================
# Verification Configuration
# ===========================================
VERIFICATION_EXPIRATION_HOURS=24
APP_BASE_URL=http://localhost:8080
