# ===========================================
# User Management Application - Environment Configuration
# ===========================================
# Copy this file to .env and replace CHANGE_ME values with actual secrets.
# Run: bin/generate-config.sh (or bin/setup.sh for full setup)

# ===========================================
# Docker Compose Configuration
# ===========================================
PROJECT_NAME=
PROJECT_VERSION=

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=userdb
DB_USERNAME=appuser
DB_PASSWORD=        # WARNING: Required. Set a secure password.

# ===========================================
# PgAdmin Configuration
# ===========================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=   # WARNING: Required. Set a secure password.
PGADMIN_PORT=5050

# ===========================================
# Application Configuration
# ===========================================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=         # WARNING: Required. Use a base64-encoded 256-bit secret.
JWT_EXPIRATION_MS=3600000
JWT_REMEMBER_ME_EXPIRATION_MS=604800000

# ===========================================
# Mail Configuration (Gmail SMTP)
# ===========================================
# Default: Gmail SMTP with TLS (port 587)
#
# Gmail App Password Setup (required):
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already enabled)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Select app: "Mail", device: "Other" (enter a name like "UserMgmt")
#   5. Click "Generate" -- Google gives you a 16-character password
#   6. Copy that password into MAIL_PASSWORD below (spaces optional)
#
# See doc/gmail-smtp-setup.md for full instructions.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com      # Your full Gmail address
MAIL_PASSWORD=abcd-efgh-ijkl-mnop       # 16-char App Password (NOT your Gmail password)
MAIL_FROM=your-gmail@gmail.com

# ===========================================
# Verification Configuration
# ===========================================
VERIFICATION_EXPIRATION_HOURS=24
APP_BASE_URL=http://localhost:8080
