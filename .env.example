# ===========================================
# User Management Application - Environment Configuration
# ===========================================
# Copy this file to .env and replace CHANGE_ME values with actual secrets.
# Run: bin/generate-config.sh (or bin/setup.sh for full setup)

# ===========================================
# Docker Compose Configuration
# ===========================================
PROJECT_NAME=
PROJECT_VERSION=

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=userdb
DB_USERNAME=appuser
DB_PASSWORD=        # WARNING: Required. Set a secure password.

# ===========================================
# PgAdmin Configuration
# ===========================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=   # WARNING: Required. Set a secure password.
PGADMIN_PORT=5050

# ===========================================
# Application Configuration
# ===========================================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# JWT Configuration (used in later phases)
# ===========================================
JWT_SECRET=         # WARNING: Required. Use a base64-encoded 256-bit secret.
JWT_EXPIRATION_MS=3600000
JWT_REMEMBER_ME_EXPIRATION_MS=604800000

# ===========================================
# Mail Configuration (used in later phases)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com      # Your full Gmail address
MAIL_PASSWORD=abcd-efgh-ijkl-mnop       # 16-char App Password (NOT your Gmail password)

# ===========================================
# Verification Configuration
# ===========================================
VERIFICATION_EXPIRATION_HOURS=24
APP_BASE_URL=http://localhost:8080